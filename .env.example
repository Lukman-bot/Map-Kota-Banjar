# ---------------------------------------------------------------
# Situs
# ---------------------------------------------------------------
# URL publik situs (tanpa garis miring di akhir). Dipakai untuk canonical, og:url, og:image
# dan sitemap.xml. Wajib diisi di produksi, terutama bila di belakang reverse proxy.
SITE_URL=https://peta.banjarkota.go.id

# ---------------------------------------------------------------
# API Open Data (hanya dibaca di SERVER — tidak pernah dikirim ke browser)
# ---------------------------------------------------------------
# Kosongkan untuk memakai data contoh lokal (mode mock) selama API belum siap.
API_BASE_URL=
# Batas waktu satu permintaan (milidetik)
API_TIMEOUT_MS=8000
# Kunci API (opsional). Dikirim sebagai:  <API_AUTH_HEADER>: <API_AUTH_SCHEME> <API_KEY>
API_KEY=
API_AUTH_HEADER=Authorization
# Isi kosong bila kunci dikirim apa adanya (mis. header X-API-Key)
API_AUTH_SCHEME=Bearer
